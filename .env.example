# Optional. Public GitHub repositories load without a token.
# A classic personal access token only raises the hourly rate limit.
# The same token lets the admin save from a host that cannot push with git.
GITHUB_TOKEN=

# Admin sign-in. Localhost skips the password. Generated in .env.local.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Public site origin, used for canonical and Open Graph URLs.
# Example: https://example.com
SITE_URL=
